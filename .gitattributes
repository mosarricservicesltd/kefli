# Fixture hashes must be byte-identical on every platform: keep LF everywhere.
* text=auto eol=lf
*.png binary
*.jpg binary
*.mp3 binary
*.m4a binary
*.zip binary
*.ttf binary
*.otf binary
*.woff2 binary
# Test vectors are kept byte for byte, so their recorded sha256 holds.
packages/protocol/test/vectors/** -text
