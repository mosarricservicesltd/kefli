    { "name": "empty fragment dropped", "url": "https://example.com/a#", "expect": "https://example.com/a" },
    { "name": "trailing slash stripped", "url": "https://example.com/a/", "expect": "https://example.com/a" },
    { "name": "bare host keeps its slash", "url": "https://example.com/", "expect": "https://example.com/" },
    { "name": "bare host without a slash gains one", "url": "https://example.com", "expect": "https://example.com/" },
    { "name": "bare host with a query keeps its slash", "url": "https://example.com/?b=2&a=1", "expect": "https://example.com/?a=1&b=2" },
    { "name": "a run of trailing slashes removed", "url": "https://example.com/a//", "expect": "https://example.com/a" },
    { "name": "a path of slashes only becomes the bare host", "url": "https://example.com///", "expect": "https://example.com/" },
    { "name": "trailing slash before a query", "url": "https://example.com/a/?x=1", "expect": "https://example.com/a?x=1" },
    { "name": "http kept as http", "url": "http://example.com/a", "expect": "http://example.com/a" },
    { "name": "default port removed", "url": "https://example.com:443/a", "expect": "https://example.com/a" },
    { "name": "other port kept", "url": "https://example.com:8443/a", "expect": "https://example.com:8443/a" },
    { "name": "dot segments resolved", "url": "https://example.com/a/./b/../c", "expect": "https://example.com/a/c" },
    { "name": "backslashes read as slashes", "url": "https:\\\\example.com\\a\\b", "expect": "https://example.com/a/b" },
    { "name": "surrounding space trimmed", "url": "  https://example.com/a \n", "expect": "https://example.com/a" },
    { "name": "space in the path percent-encoded", "url": "https://example.com/a b", "expect": "https://example.com/a%20b" },
    { "name": "non-ASCII path percent-encoded", "url": "https://example.com/café", "expect": "https://example.com/caf%C3%A9" },
    { "name": "existing escapes kept as written", "url": "https://example.com/caf%c3%a9", "expect": "https://example.com/caf%c3%a9" },
    { "name": "user info kept", "url": "https://user:pw@example.com/a", "expect": "https://user:pw@example.com/a" },
    { "name": "www kept", "url": "https://www.example.com/a", "expect": "https://www.example.com/a" },
    { "name": "trailing dot on the host kept", "url": "https://Example.com./a", "expect": "https://example.com./a" },

