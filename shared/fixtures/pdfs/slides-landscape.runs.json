{"ok":true,"title":"data:text/html;charset=utf-8;base64,","author":null,"pages":[{"w":792,"h":612,"runs":[["Kefli in five slides",56.54,123,40,337.86,0],["A read-it-later app that reads to you.",56.54,181.5,19.99,318.95,0]]},{"w":792,"h":612,"runs":[["Save anything",56.54,111.75,30,203.39,0],["Share a link from any app on the phone.",86.54,165,19.99,355.65,0],["Press the shortcut in the browser.",86.54,190.5,19.99,296.69,0],["The text arrives clean and stays offline.",86.54,216.75,19.99,346.34,0]]},{"w":792,"h":612,"runs":[["Read it clean",56.54,111.75,30,185.07,0],["One column, your size, your colours.",86.54,165,19.99,324.45,0],["Images where the writer put them.",86.54,190.5,19.99,302.24,0],["Your place kept on every device.",86.54,216.75,19.99,288.22,0]]},{"w":792,"h":612,"runs":[["Listen to it",56.54,111.75,30,151.66,0],["The phone's own voice reads the article aloud.",86.54,165,19.99,411.69,0],["Each word lights up as it is spoken.",86.54,190.5,19.99,312.26,0],["It keeps going with the screen locked.",86.54,216.75,19.99,333.4,0]]},{"w":792,"h":612,"runs":[["Keep it",56.54,111.75,30,100.02,0],["Your library lives under your own key.",86.54,165,19.99,330.03,0],["Copies are mirrored away from our servers.",86.54,190.5,19.99,385.52,0],["It outlives the service that saved it.",86.54,216.75,19.99,305.58,0]]}]}
