{
  "$version": "0.1.0",
  "$status": "draft — frozen when Stage 0 screens are approved",
  "style": "soft-pills",
  "color": {
    "light": {
      "background": "#FCF7F6",
      "surface": "#FFFFFF",
      "line": "#E9EAEB",
      "text": "#181D27",
      "muted": "#535862",
      "accent": "#B5542E",
      "accent-soft": "#F8EEEA",
      "on-accent": "#FFFFFF",
      "success": "#079455",
      "error": "#D92D20"
    },
    "dark": {
      "background": "#0C0E12",
      "surface": "#13161B",
      "line": "#22262F",
      "text": "#F7F7F7",
      "muted": "#94979C",
      "accent": "#CA8469",
      "accent-soft": "#311D18",
      "on-accent": "#0C0E12",
      "success": "#47CD89",
      "error": "#F97066"
    }
  },
  "brand": {
    "25": "#FDFAF9", "50": "#FAF3F0", "100": "#F3E4DE", "200": "#E7C8BC", "300": "#DAAA97",
    "400": "#CA8469", "500": "#BE6947", "600": "#B5542E", "700": "#944526", "800": "#77371E",
    "900": "#5E2C18", "950": "#411E11"
  },
  "gradient": {
    "primary": { "from": "#BE6947", "to": "#944526", "angle": 180, "use": "primary action only" }
  },
  "shadow": {
    "card": [
      { "x": 0, "y": 1, "blur": 2, "color": "#1018280D" },
      { "x": 0, "y": 4, "blur": 12, "color": "#1018280F" }
    ]
  },
  "type": {
    "ui": { "family": "system (Roboto on Android; Inter in Figma)", "sizes": [13, 15, 17, 20, 28, 32] },
    "reader": { "family": "Noto Serif", "size": 18, "lineHeight": 1.55, "themes": ["light", "sepia", "dark"] }
  },
  "space": [4, 8, 12, 16, 20, 24, 32],
  "radius": { "container": 10, "pill": 999 },
  "icons": "lucide",
  "changelog": [
    "0.1.0 (2026-09-27): Soft pills, Terracotta accent, Lucide icons chosen by Richard. Added on-accent (a tenth colour) because text on an accent fill must be white in light mode and near-black in dark mode, where white on #CA8469 fails contrast (2.8:1). Contrast checked: accent on surface 4.9:1 light, 6.1:1 dark; muted on background 6.7:1 light, 6.6:1 dark. Accent text on accent-soft is 4.3:1 in light mode, below AA for small text, so soft chips use the text colour for labels and the accent only for icons."
  ]
}
