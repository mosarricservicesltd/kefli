# The website's settings, read by every dev, build and deploy (README, "Links and downloads"). Nothing here is
# secret, so it is committed; the repository ignores .env files, which override it on one machine, as does the
# shell. A link left at # builds as a plain element marked Soon; set the real address, commit, and deploy.

VITE_SITE_URL=https://kefli.app
VITE_CONTACT_EMAIL=privacy@kefli.app
VITE_APK_LABEL=Android 8 or later

VITE_APK_URL="#"
VITE_ZAPSTORE_URL="#"
VITE_CHROME_STORE_URL="#"
VITE_CHROME_ZIP_URL="#"
VITE_FIREFOX_STORE_URL="#"
VITE_FIREFOX_XPI_URL="#"
VITE_SOURCE_URL="#"
