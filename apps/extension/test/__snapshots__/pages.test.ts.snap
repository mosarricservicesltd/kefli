tColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="2" width="14" height="20" rx="7"></rect><path d="M12 6v4"></path></svg></span><span class="t">Right-click a link, then Save link to Kefli</span></div></div></section><details class="adv" open=""><summary data-act="adv"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg></span><span class="t">Advanced</span><span class="chev"><span class="chevr"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"></path></svg></span></span></summary><section class="sect" style="margin-top:var(--space-8)"><h2>Relays</h2><div class="list"><div class="li edge-t"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg></span><span class="t">Kefli<small>relay.example</small></span></div><div class="li"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg></span><span class="t">Backup 1<small>a.example/</small></span></div><div class="li edge-b"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg></span><span class="t">Your relay<small>mine.example</small></span></div></div><p class="fine">Set by your phone when you connected this browser.</p></section><section class="sect"><h2>This browser</h2><div class="list"><div class="li edge-t edge-b"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span><span class="t">Kefli 1.0.1<small>store · abc1234</small></span><button class="chip" data-act="debug">Copied</button></div></div><p class="fine">For a bug report. It lists what became of your last twenty saves, without their addresses or titles, and nothing that could open them.</p></section></details><div class="sect"><button class="btn secondary destructive" data-act="unpair">Disconnect this browser</button><p class="fine">To stop this browser completely, also remove it under Connected browsers on your phone. If you undo a save your phone already picked up, remove it there too.</p></div></div>"`;

exports[`the options page pairing a code to scan, then expired: a code to scan 1`] = `"<div class="in"><div class="brandrow"><span class="lg"><svg></svg></span>Kefli</div><h1 tabindex="-1">Connect to your phone</h1><p class="lead">Pages you save here arrive in Kefli on your phone. Your phone decides which browsers it trusts, so you connect them from there.</p><div class="card"><div class="seg first edge-t last edge-b"><div class="pair"><div class="qr " data-theme="light"><svg width="168" height="168" viewBox="-1 -1 71 71" fill="currentColor" shape-rendering="crispEdges" role="img" aria-label="Connection code"><path d="M0 0h1v1h-1zM1 0h1v1h-1zM2 0h1v1h-1zM3 0h1v1h-1zM4 0h1v1h-1zM5 0h1v1h-1zM6 0h1v1h-1zM9 0h1v1h-1zM11 0h1v1h-1zM12 0h1v1h-1zM13 0h1v1h-1zM15 0h1v1h-1zM17 0h1v1h-1zM18 0h1v1h-1zM22 0h1v1h-1zM23 0h1v1h-1zM24 0h1v1h-1zM28 0h1v1h-1zM29 0h1v1h-1zM33 0h1v1h-1zM35 0h1v1h-1zM41 0h1v1h-1zM42 0h1v1h-1zM45 0h1v1h-1zM48 0h1v1h-1zM49 0h1v1h-1zM53 0h1v1h-1zM54 0h1v1h-1zM55 0h1v1h-1zM58 0h1v1h-1zM59 0h1v1h-1zM60 0h1v1h-1zM62 0h1v1h-1zM63 0h1v1h-1zM64 0h1v1h-1zM65 0h1v1h-1zM66 0h1v1h-1zM67 0h1v1h-1zM68 0h1v1h-1zM0 1h1v1h-1zM6 1h1v1h-1zM8 1h1v1h-1zM9 1h1v1h-1zM10 1h1v1h-1zM12 1h1v1h-1zM13 1h1v1h-1zM14 1h1v1h-1zM19 1h1v1h-1zM23 1h1v1h-1zM24 1h1v1h-1zM27 1h1v1h-1zM28 1h1v1h-1zM29 1h1v1h-1zM30 1h1v1h-1zM31 1h1v1h-1zM32 1h1v1h-1zM33 1h1v1h-1zM34 1h1v1h-1zM36 1h1v1h-1zM37 1h1v1h-1zM38 1h1v1h-1zM45 1h1v1h-1zM46 1h1v1h-1zM47 1h1v1h-1zM50 1h1v1h-1zM51 1h1v1h-1zM55 1h1v1h-1zM57 1h1v1h-1zM62 1h1v1h-1zM68 1h1v1h-1zM0 2h1v1h-1zM2 2h1v1h-1zM3 2h1v1h-1zM4 2h1v1h-1zM6 2h1v1h-1zM9 2h1v1h-1zM11 2h1v1h-1zM12 2h1v1h-1zM14 2h1v1h-1zM15 2h1v1h-1zM21 2h1v1h-1zM25 2h1v1h-1zM28 2h1v1h-1zM30 2h1v1h-1zM31 2h1v1h-1zM33 2h1v1h-1zM35 2h1v1h-1zM39 2h1v1h-1zM40 2h1v1h-1zM43 2h1v1h-1zM44 2h1v1h-1zM52 2h1v1h-1zM53 2h1v1h-1zM54 2h1v1h-1zM56 2h1v1h-1zM57 2h1v1h-1zM58 2h1v1h-1zM62 2h1v1h-1zM64 2h1v1h-1zM65 2h1v1h-1zM66 2h1v1h-1zM68 2h1v1h-1zM0 3h1v1h-1zM2 3h1v1h-1zM3 3h1v1h-1zM4 3h1v1h-1zM6 3h1v1h-1zM8 3h1