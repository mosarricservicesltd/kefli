exports[`the browser-page popup each state, from the save in session storage: the cover’s stylesheet 1`] = `"<style>.lf{transform-box:fill-box;transform-origin:center;animation:drawin .52s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i) * 34ms)}@keyframes drawin{from{opacity:0;transform:scale(.3)}}.loop .lf{animation:drawloop 4.4s cubic-bezier(.2,.8,.2,1) infinite both;animation-delay:calc(var(--i) * 42ms)}@keyframes drawloop{0%{opacity:0;transform:scale(.3)}11%,82%{opacity:1;transform:none}93%,100%{opacity:0;transform:scale(.85)}}@media (prefers-reduced-motion:reduce){.lf,.loop .lf{animation:none!important}}</style>"`;

exports[`the browser-page popup each state, from the save in session storage: undone 1`] = `"<div class="popup" id="popup" role="dialog" aria-label="Kefli" tabindex="-1" style=""><div class="row"><div class="lead"><span class="tile " aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"></path></svg></span></div><div class="tx"><b>Removed from Kefli</b><span class="wrap2">If your phone already has it, remove it there.</span></div><button class="x" data-act="close" aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="timer"><i></i></div></div>"`;

exports[`the options page connected: pinned, no shortcut, nothing waiting, and Disconnect alone: Disconnect, asked to confirm 1`] = `"<div class="in"><div class="brandrow"><span class="lg"><svg></svg></span>Kefli</div><div class="titlerow"><span class="ok"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"></path></svg></span><h1 tabindex="-1">Connected to your phone</h1></div><p class="lead">Since 14 October · your phone shows this browser as “Chrome on a “Mac””</p><section class="sect"><h2>Ways to save</h2><div class="list"><div class="li edge-t"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path></svg></span><span class="t">Click the Kefli button in the toolbar</span></div><div class="li"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 8h.01M12 12h.01M14 8h.01M16 12h.01M18 8h.01M6 8h.01M7 16h10M8 12h.01"></path><rect width="20" height="16" x="2" y="4" rx="2"></rect></svg></span><span class="t">No shortcut set</span><button class="chip" data-act="setkey">Set a shortcut</button></div><div class="li edge-b"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="2" width="14" height="20" rx="7"></rect><path d="M12 6v4"></path></svg></span><span class="t">Right-click a link, then Save link to Kefli</span></div></div></section><details class="adv"><summary data-act="adv"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg></span><span class="t">Advanced</span><span class="chev"><span class="chevr"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"></path></svg></span></span></summary></details><div class="sect"><div class="confirm" role="group" aria-labelledby="unpairhead"><h2 id="unpairhead">Disconnect this browser?</h2><p>This browser will stop sending saves to your phone. To stop it completely, also remove it under Connected browsers on your phone.</p><div class="row"><button class="btn secondary" data-act="unpair-cancel">Cancel</button><button class="btn danger" data-act="unpair-yes">Disconnect</button></div></div></div></div>"`;

exports[`the options page connected: pinned, no shortcut, nothing waiting, and Disconnect alone: connected, pinned, no shortcut 1`] = `"<div class="in"><div class="brandrow"><span class="lg"><svg></svg></span>Kefli</div><div class="titlerow"><span class="ok"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"></path></svg></span><h1 tabindex="-1">Connected to your phone</h1></div><p class="lead">Since 14 October · your phone shows this browser as “Chrome on a “Mac””</p><section class="sect"><h2>Ways to save</h2><div class="list"><div class="li edge-t"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path></svg></span><span class="t">Click the Kefli button in the toolbar</span></div><div class="li"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 8h.01M12 12h.01M14 8h.01M16 12h.01M18 8h.01M6 8h.01M7 16h10M8 12h.01"></path><rect width="20" height="16" x="2" y="4" rx="2"></rect></svg></span><span class="t">No shortcut set</span><button class="chip" data-act="setkey">Set a shortcut</button></div><div class="li edge-b"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="2" width="14" height="20" rx="7"></rect><path d="M12 6v4"></path></svg></span><span class="t">Right-click a link, then Save link to Kefli</span></div></div></section><details class="adv"><summary data-act="adv"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg></span><span class="t">Advanced</span><span class="chev"><span class="chevr"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"></path></svg></span></span></summary></details><div class="sect"><button class="btn secondary destructive" data-act="unpair">Disconnect this browser</button><p class="fine">To stop this browser completely, also remove it under Connected browsers on your phone. If you undo a save your phone already picked up, remove it there too.</p></div></div>"`;

