.lf{transform-box:fill-box;transform-origin:center;animation:drawin .52s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i) * 34ms)}@keyframes drawin{from{opacity:0;transform:scale(.3)}}.loop .lf{animation:drawloop 4.4s cubic-bezier(.2,.8,.2,1) infinite both;animation-delay:calc(var(--i) * 42ms)}@keyframes drawloop{0%{opacity:0;transform:scale(.3)}11%,82%{opacity:1;transform:none}93%,100%{opacity:0;transform:scale(.85)}}@media (prefers-reduced-motion:reduce){.lf,.loop .lf{animation:none!important}}</style><div class="toast" role="group" aria-label="Kefli" style="--ink: #6387D3;"><div class="row"><div class="lead"><span class="cv" aria-hidden="true"><svg viewBox="0 0 800 800" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><g><rect width="800" height="800" fill="#DFF1F0"></rect><g transform="translate(0 0)"><g class="lf" style="--i:0"><rect fill="#0F3F2E" width="202" height="202"></rect><g transform="rotate(90 100 100)"><path fill="#6387D3" d="M200 0A200 200 0 0 1 0 200A200 200 0 0 1 200 0Z"></path></g></g></g><g transform="translate(200 0)"><g class="lf" style="--i:1"><rect fill="#6387D3" width="202" height="202"></rect><g transform="rotate(90 100 100)"><path fill="#98CFB7" d="M0 0H200A200 200 0 0 1 0 200Z"></path><path fill="#98CFB7" d="M0 -2H200V2H0ZM-2 0H2V200H-2Z"></path></g></g></g><g transform="translate(0 200)"><g class="lf" style="--i:2"><rect fill="#98CFB7" width="102" height="102"></rect><g transform="rotate(180 50 50)"><path fill="#DFF1F0" d="M0 0H100A100 100 0 0 1 0 100Z"></path><path fill="#DFF1F0" d="M0 -2H100V2H0ZM-2 0H2V100H-2Z"></path></g></g></g><g transform="translate(100 200)"><g class="lf" style="--i:3"><rect fill="#DFF1F0" width="102" height="102"></rect><g transform="rotate(180 50 50)"><path fill="#6387D3" d="M0 0H100L0 100Z"></path><path fill="#6387D3" d="M0 -2H100V0L98 2H0ZM-2 0H2V98L0 100H-2Z"></path></g></g></g><g transform="translate(0 300)"><g class="lf" style="--i:4"><rect fill="#0F3F2E" width="102" height="102"></rect><g transform="rotate(180 50 50)"><path fill="#6387D3" d="M0 0H100L0 100Z"></path><path fill="#6387D3" d="M0 -2H100V0L98 2H0ZM-2 0H2V98L0 100H-2Z"></path></g></g></g><g transform="translate(100 300)"><g class="lf" style="--i:5"><rect fill="#DFF1F0" width="102" height="102"></rect><g transform="rotate(0 50 50)"><circle fill="#6387D3" cx="50" cy="50" r="20"></circle></g></g></g><g transform="translate(200 200)"><g class="lf" style="--i:6"><rect fill="#0F3F2E" width="202" height="202"></rect><g transform="rotate(90 100 100)"><circle fill="#98CFB7" cx="100" cy="100" r="40"></circle></g></g></g><g transform="translate(400 0)"><g class="lf" style="--i:7"><rect fill="#DFF1F0" width="402" height="402"></rect><g transform="rotate(90 200 200)"><path fill="#6387D3" d="M0 0H400A400 400 0 0 1 0 400Z"></path><path fill="#6387D3" d="M0 -2H400V2H0ZM-2 0H2V400H-2Z"></path></g></g></g><g transform="translate(0 400)"><g class="lf" style="--i:8"><rect fill="#6387D3" width="202" height="202"></rect><g transform="rotate(270 100 100)"><circle fill="#98CFB7" cx="100" cy="100" r="100"></circle></g></g></g><g transform="translate(200 400)"><g class="lf" style="--i:9"><rect fill="#98CFB7" width="202" height="202"></rect><g transform="rotate(90 100 100)"></g></g></g><g transform="translate(0 600)"><g class="lf" style="--i:10"><rect fill="#DFF1F0" width="202" height="202"></rect><g transform="rotate(90 100 100)"><path fill="#98CFB7" d="M0 0H200A200 200 0 0 1 0 200Z"></path><path fill="#98CFB7" d="M0 -2H200V2H0ZM-2 0H2V200H-2Z"></path></g></g></g><g transform="translate(200 600)"><g class="lf" style="--i:11"><rect fill="#DFF1F0" width="102" height="102"></rect><g transform="rotate(90 50 50)"><circle fill="#0F3F2E" cx="50" cy="50" r="20"></circle></g></g></g><g transform="translate(300 600)"><g class="lf" style="--i:12"><rect fill="#0F3F2E" width="102" height="102"></rect><g transform="rotate(0 50 50)"></g></g></g><g transform="translate(200 700)"><g class="lf" style="--i:13"><rect fill="#DFF1F0" width="102" height="102"></rect><g transform="rotate(0 50 50)"><path fill="#6387D3" d="M0 0H100A100 100 0 0 1 0 100Z"></path><path fill="#6387D3" d="M0 -2H100V2H0ZM-2 0H2V100H-2Z"></path></g></g></g><g transform="translate(300 700)"><g class="lf" style="--i:14"><rect fill="#0F3F2E" width="102" height="102"></rect><g transform="rotate(270 50 50)"><path fill="#6387D3" d="M0 0H100A100 100 0 0 1 0 100Z"></path><path fill="#6387D3" d="M0 -2H100V2H0ZM-2 0H2V100H-2Z"></path></g></g></g><g transform="translate(400 400)"><g class="lf" style="--i:15"><rect fill="#DFF1F0" width="402" height="402"></rect><g transform="rotate(90 200 200)"><path fill="#98CFB7" d="M0 0H400A400 400 0 0 1 0 400Z"></path><path fill="#DFF1F0" d="M0 0H266.6666666666667A266.6666666666667 266.6666666666667 0 0 1 0 266.6666666666667Z"></path><path fill="#98CFB7" d="M0 0H133.33333333333334A133.33333333333334 133.33333333333334 0 0 1 0 133.33333333333334Z"></path><path fill="#98CFB7" d="M0 -2H133.33333333333334V2H0ZM266.6666666666667 -2H400V2H266.6666666666667ZM-2 0H2V133.33333333333334H-2ZM-2 266.6666666666667H2V400H-2Z"></path><path fill="#DFF1F0" d="M133.33333333333334 -2H266.6666666666667V2H133.33333333333334ZM-2 133.33333333333334H2V266.6666666666667H-2Z"></path></g></g></g></g></svg></span></div><div class="tx"><b>Saving…</b><span class="">A page &amp; its &lt;title&gt;</span></div><button class="x" data-act="close" aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="timer"></div></div><div class="sr" role="status" aria-live="polite"></div>"
`;

exports[`the toast each state, then reached by the shortcut: undone 1`] = `
"<style>
:host{all:initial !important;position:fixed !important;right:16px !important;bottom:16px !important;left:auto !important;top:auto !important;z-index:2147483647 !important;margin:0 !important;padding:0 !important;border:0 !important;background:none !important;overflow:visible !important;inset:auto 16px 16px auto !important}
.toast{--text:#EDECE8;--muted:#A7A59F;--success:#5DC68C;--error:#FF8B7B;--on-fill:#111112;--focus:#EDECE8;--line:#2E2E31;--cover-edge:#EDECE81A;--toast-bg:#17171A;--toast-fg:#F3F2EE;--toast-shadow:0px 12px 28px -10px #17171A4D, 0px 0px 0px 1px #DEDCD5;--ring:#17171A;
  --motion-enter:250ms cubic-bezier(.2,.8,.2,1);--motion-exit:200ms cubic-bezier(.4,0,1,1);
  color-scheme:light dark;width:336px;max-width:calc(100vw - 32px);box-sizing:border-box;
  background:var(--toast-bg);color:var(--toast-fg);border-radius:14px;box-shadow:var(--toast-shadow);
  font:15px/1.45 system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;letter-spacing:normal;text-transform:none;text-align:left;direction:ltr;
  overflow:hidden;transition:opacity var(--motion-enter),transform var(--motion-enter)}
@media (prefers-color-scheme:dark){.toast{--text:#17171A;--muted:#5C5B56;--success:#1E7A4A;--error:#B42318;--on-fill:#F3F2EE;--focus:#17171A;--line:#DEDCD5;--cover-edge:#17171A17;--toast-bg:#EDECE8;--toast-fg:#111112;--toast-shadow:0px 0px 0px 1px #3A3A3E, 0px 12px 28px -10px #000000B3;--ring:#EDECE8;}}
@starting-style{.toast{opacity:0;transform:translateY(24px)}}
.toast.leave{opacity:0;transform:translateY(24px);transition:opacity var(--motion-exit),transform var(--motion-exit);pointer-events:none}
*{box-sizing:border-box}
button{font:inherit;color:inherit;background:none;border:0;margin:0;padding:0;cursor:pointer}
.row{position:relative;display:flex;align-items:center;gap:12px;padding:12px 8px 12px 12px;min-height:64px}
.lead{position:relative;width:40px;height:40px;flex:none}
.cv{display:block;position:relative;overflow:hidden;width:40px;height:40px;border-radius:8px}
.cv svg{display:block;width:100%;height:100%}
.cv::after{content:"";position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 0 0 1px var(--cover-edge);pointer-events:none}
.tile{width:40px;height:40px;border-radius:8px;box-shadow:inset 0 0 0 1px var(--muted);display:flex;align-items:center;justify-content:center;color:var(--muted)}
.tile.bad{color:var(--error)}
.mk{position:absolute;right:-5px;bottom:-5px;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 2px var(--ring);animation:markIn 200ms cubic-bezier(.2,.8,.2,1) var(--mk-delay,0ms) both}
.mk.ok{background:var(--success);color:var(--on-fill)}
.mk.bad{background:var(--error);color:var(--on-fill)}
.mk.off{background:var(--ring);color:var(--toast-fg);box-shadow:inset 0 0 0 1px var(--muted),0 0 0 2px var(--ring)}
@keyframes markIn{from{opacity:0;transform:scale(.4)}}
@keyframes markFade{from{opacity:0}}
.tx{flex:1;min-width:0}
.tx b{display:block;font-size:15px;font-weight:620;line-height:1.3}
.tx span{display:block;font-size:13px;color:var(--muted);line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tx span.wrap2{white-space:normal}
.act{height:36px;padding:0 12px;border-radius:8px;font-weight:620;font-size:13px;line-height:1;flex:none;display:inline-flex;align-items:center;color:var(--toast-fg)}
.x{width:32px;height:32px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;color:var(--muted);flex:none}
.act:hover,.x:hover{background:color-mix(in srgb, var(--toast-fg) 12%, transparent)}
button:focus-visible,.viakey button:focus{outline:2px solid var(--focus);outline-offset:-2px}
.timer{height:2px;overflow:hidden}
.timer i{display:block;height:100%;background:var(--ink, var(--toast-fg));animation:countdown 8000ms linear forwards}
.paused .timer i{animation-play-state:paused}
@keyframes countdown{to{transform:translateX(-100%)}}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media (prefers-reduced-motion:reduce){@starting-style{.toast{transform:none}}.toast.leave{transform:none}.mk{animation:markFade 150ms both}}
@media (forced-colors:active){.toast,.tile,.mk{border:1px solid CanvasText}.act,.x{border:1px solid ButtonText}.timer i{forced-color-adjust:none;background:CanvasText}.cv{forced-color-adjust:none}}
.lf{transform-box:fill-box;transform-origin:center;animation:drawin .52s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i) * 34ms)}@keyframes drawin{from{opacity:0;transform:scale(.3)}}.loop .lf{animation:drawloop 4.4s cubic-bezier(.2,.8,.2,1) infinite both;animation-delay:calc(var(--i) * 42ms)}@keyframes drawloop{0%{opacity:0;transform:scale(.3)}11%,82%{opacity:1;transform:none}93%,100%{opacity:0;transform:scale(.85)}}@media (prefers-reduced-motion:reduce){.lf,.loop .lf{animation:none!important}}</style><div class="toast" role="group" aria-label="Kefli" style=""><div class="row"><div class="lead"><span class="tile " aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"></path></svg></span></div><div class="tx"><b>Removed from Kefli</b><span class="wrap2">If your phone already has it, remove it there.</span></div><button class="x" data-act="close" aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="timer"><i></i></div></div><div class="sr" role="status" aria-live="polite"></div>"
`;
