exports[`the options page pairing a code to scan, then expired: expired 1`] = `"<div class="in"><div class="brandrow"><span class="lg"><svg></svg></span>Kefli</div><h1 tabindex="-1">Connect to your phone</h1><p class="lead">Pages you save here arrive in Kefli on your phone. Your phone decides which browsers it trusts, so you connect them from there.</p><div class="card"><div class="seg first edge-t last edge-b"><div class="pair"><div class="qr faded" data-theme="light"><svg width="168" height="168" role="img" aria-label="Connection code, not available"></svg><div class="code" aria-hidden="true">––––-––––</div></div><ol class="steps"><li>Open Kefli on your phone.</li><li>Go to <strong>You</strong>, then <strong>Connected browsers</strong>, then <strong>Connect a browser</strong>.</li><li>Scan the code, or type the code under it.</li><li>Check that your phone names this browser <strong>This browser on a computer</strong>, then tap <strong>Connect</strong>.</li></ol></div><div class="status plain"><div class="errline" style="margin:0;flex:1"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4M12 16h.01"></path></svg><span>This code has expired.</span></div><button class="btn primary" data-act="newcode"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>Show a new one</button></div></div></div></div>"`;

exports[`the options page pairing can’t connect right now: offline, not pinned 1`] = `"<div class="in"><div class="brandrow"><span class="lg"><svg></svg></span>Kefli</div><h1 tabindex="-1">Connect to your phone</h1><div class="errline"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4M12 16h.01"></path></svg><span>Can’t connect right now. Check your connection. Trying again every ten seconds.</span></div><p class="lead">Pages you save here arrive in Kefli on your phone. Your phone decides which browsers it trusts, so you connect them from there.</p><div class="card"><div class="seg pinseg first edge-t"><div class="li pinline"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.706 1.087.706 1.704s-.235 1.233-.706 1.704l-1.611 1.611a.98.98 0 0 1-.837.276c-.47-.07-.802-.48-.968-.925a2.501 2.501 0 1 0-3.214 3.214c.446.166.855.497.925.968a.979.979 0 0 1-.276.837l-1.61 1.61a2.404 2.404 0 0 1-1.705.707 2.402 2.402 0 0 1-1.704-.706l-1.568-1.568a1.026 1.026 0 0 0-.877-.29c-.493.074-.84.504-1.02.968a2.5 2.5 0 1 1-3.237-3.237c.464-.18.894-.527.967-1.02a1.026 1.026 0 0 0-.289-.877l-1.568-1.568A2.402 2.402 0 0 1 1.998 12c0-.617.236-1.234.706-1.704L4.23 8.77c.24-.24.581-.353.917-.303.515.077.877.528 1.073 1.01a2.5 2.5 0 1 0 3.259-3.259c-.482-.196-.933-.558-1.01-1.073-.05-.336.062-.676.303-.917l1.525-1.525A2.402 2.402 0 0 1 12 1.998c.617 0 1.234.236 1.704.706l1.568 1.568c.23.23.556.338.877.29.493-.074.84-.504 1.02-.968a2.5 2.5 0 1 1 3.237 3.237c-.464.18-.894.527-.967 1.02Z"></path></svg></span><span class="t">Pin Kefli to your toolbar: click the puzzle piece, then the pin next to Kefli.</span></div></div><div class="seg  last edge-b"><div class="pair"><div class="qr faded" data-theme="light"><svg width="168" height="168" role="img" aria-label="Connection code, not available"></svg><div class="code" aria-hidden="true">––––-––––</div></div><ol class="steps"><li>Open Kefli on your phone.</li><li>Go to <strong>You</strong>, then <strong>Connected browsers</strong>, then <strong>Connect a browser</strong>.</li><li>Scan the code, or type the code under it.</li><li>Check that your phone names this browser <strong>This browser on a computer</strong>, then tap <strong>Connect</strong>.</li></ol></div></div></div></div>"`;

exports[`the toast each state, then reached by the shortcut: browser page, a link 1`] = `
"<style>
:host{all:initial !important;position:fixed !important;right:16px !important;bottom:16px !important;left:auto !important;top:auto !important;z-index:2147483647 !important;margin:0 !important;padding:0 !important;border:0 !important;background:none !important;overflow:visible !important;inset:auto 16px 16px auto !important}
.toast{--text:#EDECE8;--muted:#A7A59F;--success:#5DC68C;--error:#FF8B7B;--on-fill:#111112;--focus:#EDECE8;--line:#2E2E31;--cover-edge:#EDECE81A;--toast-bg:#17171A;--toast-fg:#F3F2EE;--toast-shadow:0px 12px 28px -10px #17171A4D, 0px 0px 0px 1px #DEDCD5;--ring:#17171A;
  --motion-enter:250ms cubic-bezier(.2,.8,.2,1);--motion-exit:200ms cubic-bezier(.4,0,1,1);
  color-scheme:light dark;width:336px;max-width:calc(100vw - 32px);box-sizing:border-box;
  background:var(--toast-bg);color:var(--toast-fg);border-radius:14px;box-shadow:var(--toast-shadow);
  font:15px/1.45 system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;letter-spacing:normal;text-transform:none;text-align:left;direction:ltr;
  overflow:hidden;transition:opacity var(--motion-enter),transform var(--motion-enter)}
