{
  "expo": {
    "name": "Shelf test",
    "slug": "mobile",
    "scheme": "shelf",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "space.shelf.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-font",
        {
          "fonts": [
            "../../shared/fonts/out/Archivo-400.ttf",
            "../../shared/fonts/out/Archivo-500.ttf",
            "../../shared/fonts/out/Archivo-550.ttf",
            "../../shared/fonts/out/Archivo-600.ttf",
            "../../shared/fonts/out/Archivo-620.ttf",
            "../../shared/fonts/out/Archivo-650.ttf",
            "../../shared/fonts/out/Archivo-680.ttf",
            "../../shared/fonts/out/Archivo-750.ttf",
            "../../shared/fonts/out/ArchivoExpanded-750.ttf",
            "../../shared/fonts/out/MartianMono-500.ttf",
            "../../shared/fonts/out/Literata-18-400.ttf",
            "../../shared/fonts/out/Literata-18-400-Italic.ttf",
            "../../shared/fonts/out/Literata-18-700.ttf",
            "../../shared/fonts/out/Literata-32-400.ttf",
            "../../shared/fonts/out/Literata-32-600.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-shelf-notification",
      [
        "expo-camera",
        {
          "cameraPermission": "Shelf uses the camera only to read the code your browser shows.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-nip55-queries"
    ]
  }
}
