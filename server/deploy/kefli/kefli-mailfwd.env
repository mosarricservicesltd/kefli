# kefli-mailfwd's settings (server/api/cmd/kefli-mailfwd/main.go): mail Resend receives for these addresses goes on to
# the operator's inbox. RESEND_API_KEY and RESEND_WEBHOOK_SECRET are not here: they live only on the box, in
# /etc/kefli/kefli-mailfwd.secret.env (root, 0600).
KEFLI_MAILFWD_ADDR=127.0.0.1:8449
KEFLI_MAILFWD_ACCEPT=privacy@kefli.app
KEFLI_MAILFWD_FROM=Kefli privacy <privacy@kefli.app>
KEFLI_MAILFWD_TO=mosarricservicesltd@gmail.com
