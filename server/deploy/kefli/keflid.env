# keflid's configuration (server/api/cmd/keflid/main.go). It listens on loopback, behind Caddy.
KEFLID_DB=/var/lib/kefli/keflid.db
KEFLID_BLOBS=/var/lib/kefli/blobs
KEFLID_API_ADDR=127.0.0.1:8447
KEFLID_BLOSSOM_ADDR=127.0.0.1:3447
KEFLID_API_BASE=https://api.kefli.app
KEFLID_BLOSSOM_BASE=https://blossom.kefli.app
KEFLID_DEFAULTS=/etc/kefli/defaults.json
KEFLID_TRUST_PROXY=1
