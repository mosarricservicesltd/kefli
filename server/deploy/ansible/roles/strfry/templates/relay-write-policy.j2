#!/bin/sh
# {{ ansible_managed }}
# strfry runs this as relay.writePolicy.plugin (contract 3.2). The plugin reads keflid's database read-only and keeps
# its own record of the wraps the relay holds next to strfry's database. Every new event waits while the disk under the
# relay's database has less than kefli_relay_min_free_mb free.
exec /usr/local/lib/kefli/kefli-writepolicy -db /var/lib/kefli/keflid.db -wraps /var/lib/strfry/wraps.db \
    -strfry /usr/local/bin/strfry -config /etc/strfry.conf -room /var/lib/strfry/db -min-free-mb {{ kefli_relay_min_free_mb }}
