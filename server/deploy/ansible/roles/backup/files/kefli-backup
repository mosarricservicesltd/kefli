#!/bin/bash
# The nightly backup (backend spec 3.8), run as root by kefli-backup.timer once /etc/kefli/restic.env exists: the
# relay's events through strfry export, keflid's database through SQLite's backup, and the blobs, each without what
# the browser hands the phone (gift wraps and inbox blobs, below), to the restic repository named there, then 14 daily and 8 weekly snapshots kept. Every byte backed up is
# already ciphertext or keys and hashes. A healthchecks address, when set, hears the start, the end and any failure.
set -euo pipefail
ping() { [ -z "${HEALTHCHECK_URL:-}" ] || curl -fsS -m 10 --retry 3 -o /dev/null "$HEALTHCHECK_URL$1" || true; }
trap 'ping /fail' ERR
ping /start

stage=/var/backups/kefli
install -d -m 700 "$stage"
# What the browser hands the phone is kept only as long as the extension's privacy note says, 14 days at most, so none
# of it goes into snapshots that last eight weeks (F31): no kind 1059 gift wraps, no record of them (wraps.db), and no
# inbox blob (one whose every owner row expires) unless a user holds it too.
runuser -u strfry -- /usr/local/bin/strfry --config=/etc/strfry.conf export 2>/dev/null | jq -c 'select(.kind != 1059)' | gzip > "$stage/strfry.jsonl.gz"
rm -f "$stage/wraps.db"
sqlite3 /var/lib/kefli/keflid.db ".backup '$stage/keflid.db'"
sqlite3 "$stage/keflid.db" "SELECT '/var/lib/kefli/blobs/' || substr(sha256, 1, 2) || '/' || sha256 FROM owners
  GROUP BY sha256 HAVING COUNT(*) = COUNT(expires_at)" > "$stage/inbox-blobs.exclude"

restic backup --quiet --tag nightly --exclude-file "$stage/inbox-blobs.exclude" "$stage" /var/lib/kefli/blobs
restic forget --quiet --tag nightly --keep-daily "$KEEP_DAILY" --keep-weekly "$KEEP_WEEKLY" --prune
ping ""
