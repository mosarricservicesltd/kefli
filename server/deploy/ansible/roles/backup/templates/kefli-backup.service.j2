# {{ ansible_managed }}
[Unit]
Description=Kefli's nightly backup (backend spec 3.8)
After=strfry.service keflid.service
# The repository, its password and the healthchecks address are written by hand (server/deploy/README.md, "Backups").
ConditionPathExists=/etc/kefli/restic.env

[Service]
Type=oneshot
EnvironmentFile=/etc/kefli/restic.env
Environment=KEEP_DAILY={{ kefli_backup_keep_daily }} KEEP_WEEKLY={{ kefli_backup_keep_weekly }}
# restic keeps its index cache here; without a home directory under systemd it would have none and reread the box.
CacheDirectory=kefli-restic
Environment=RESTIC_CACHE_DIR=/var/cache/kefli-restic
ExecStart=/usr/local/lib/kefli/kefli-backup
Nice=10
IOSchedulingClass=idle
